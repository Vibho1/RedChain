# ─────────────────────────────────────────────
# RedChain — Environment Variables
# Copy this file to .env and fill in your keys
# Never commit .env to git
# ─────────────────────────────────────────────

# LLM used by the Attacker Planner (the red-team brain)
# Supports any LiteLLM-compatible model string
ATTACKER_LLM=claude-3-5-sonnet-20241022
ATTACKER_LLM_API_KEY=your-anthropic-api-key-here

# LLM used by the Judge Scorer (fallback evaluator)
JUDGE_LLM=gemini/gemini-1.5-pro
JUDGE_LLM_API_KEY=your-google-api-key-here

# Optional: OpenAI key if using GPT-4 as attacker or judge
OPENAI_API_KEY=your-openai-api-key-here

# Local storage path for attack logs and audit reports
REDCHAIN_DB_PATH=./redchain_data/attacks.db
REDCHAIN_REPORTS_DIR=./redchain_data/reports

# FastAPI server settings
REDCHAIN_API_HOST=0.0.0.0
REDCHAIN_API_PORT=8000

# Set to "true" to enable verbose debug logging
REDCHAIN_DEBUG=false